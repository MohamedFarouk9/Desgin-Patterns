import { Router, type Request, type Response } from "express";
import { WeatherData, CurrentConditionsDisplay, StatisticsDisplay } from "../Behavioral-Patterns/Observer/Observer.js";

const router = Router();
const weatherData = new WeatherData();

// Create observers
const currentDisplay = new CurrentConditionsDisplay();
const statsDisplay = new StatisticsDisplay();

// Register observers with the weather data
weatherData.attach(currentDisplay);
weatherData.attach(statsDisplay);

router.post("/measurements", (req: Request, res: Response) => {
  try {
    const { temperature, humidity, pressure } = req.body;

    if (temperature === undefined) {
      return res.status(400).json({ error: "temperature is required." });
    }

    // Set measurements (this will notify all observers)
    weatherData.setMeasurements(
      temperature,
      humidity !== undefined ? humidity : 50,
      pressure !== undefined ? pressure : 1013
    );

    return res.status(200).json({
      message: "✅ Measurements updated, observers notified",
      temperature,
      humidity,
      pressure,
      observersNotified: 2,
    });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : "Internal error";
    return res.status(500).json({ error: message });
  }
});

router.post("/attach", (req: Request, res: Response) => {
  try {
    const { observerType } = req.body;

    if (!observerType) {
      return res.status(400).json({ error: "observerType is required." });
    }

    // In a real app, we'd instantiate the specific observer class
    // For demo, we'll just note the attachment
    console.log(`[Observer] Would attach: ${observerType}`);

    return res.status(200).json({
      message: `Observer type ${observerType} registration pattern demonstrated`,
    });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : "Internal error";
    return res.status(500).json({ error: message });
  }
});

router.get("/state", (req: Request, res: Response) => {
  try {
    return res.status(200).json({
      message: "Current weather station state",
      temperature: weatherData.getTemperature(),
      humidity: weatherData.getHumidity(),
      pressure: weatherData.getPressure(),
      observersAttached: weatherData['observers']?.length || 0,
    });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : "Internal error";
    return res.status(500).json({ error: message });
  }
});

export default router;