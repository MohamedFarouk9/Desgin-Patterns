import { Router, type Request, type Response } from "express";
import { MediaProcessingFacade, PipelineResult } from "../Structural-Patterns/Facade/MediaProcessingFacade.js";
import { CloudFactoryProvider } from "../Abstract-Factory/CloudInfrastructureFactory.js";

const router = Router();

router.post("/process-media", async (req: Request, res: Response) => {
  try {
    const { provider, fileName, fileContentBase64 } = req.body;

    // Create facade with specified provider (or use environment default)
    const facade = new MediaProcessingFacade(provider);

    // Single method call replaces complex multi-service orchestration
    const result: PipelineResult = await facade.processMedia(fileName || "", fileContentBase64 || "");

    if (!result.success) {
      return res.status(500).json({
        error: result.error || "Media processing failed",
      });
    }

    return res.status(200).json({
      message: `✅ Media pipeline executed via Facade Pattern (${result.provider})`,
      pipelineResults: result.pipelineResults,
      processedAt: result.processedAt,
    });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : "Internal error";
    return res.status(500).json({ error: message });
  }
});

router.get("/providers", (req: Request, res: Response) => {
  try {
    const providers = ["aws", "gcp", "local"];
    return res.status(200).json({
      availableProviders: providers,
      defaultProvider: process.env.CLOUD_PROVIDER || "local",
    });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : "Internal error";
    return res.status(500).json({ error: message });
  }
});

export default router;