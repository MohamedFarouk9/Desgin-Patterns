import { Router, type Request, type Response } from "express";
import { Asset, AssetIntrinsicState, AssetExtrinsicState, AssetRegistry } from "../Structural-Patterns/Flyweight/AssetRegistry.js";

const router = Router();

// In-memory registry for demo (in production would be singleton or DI)
const registry = new AssetRegistry();

// Pre-populate some assets on first access
registry.getOrCreate("logo-primary", "/assets/images/logo.png", "200x200", "PNG", 45000);
registry.getOrCreate("icon-user", "/assets/icons/user.svg", "32x32", "SVG", 2000);
registry.getOrCreate("bg-header", "/assets/images/banner.jpg", "1200x400", "JPEG", 250000);

router.post("/asset/get-or-create", (req: Request, res: Response) => {
  try {
    const { assetId, filePath, dimensions, format, size, requester } = req.body;

    if (!assetId || !requester) {
      return res.status(400).json({ error: "assetId and requester are required." });
    }

    // Get or create flyweight (intrinsic state shared)
    const asset = AssetRegistry.getOrCreate(
      assetId,
      filePath || `/assets/${assetId}.png`,
      dimensions || "200x200",
      format || "PNG",
      size || 50000
    );

    // Request asset with extrinsic state (unique per request)
    const extrinsic = asset.request(requester, "memory");

    return res.status(200).json({
      message: "✅ Flyweight asset retrieved/shared successfully",
      assetId,
      isShared: true, // In a real multi-user scenario, this would be compared across requests
      intrinsicState: asset.getIntrinsicState(),
      extrinsicState: extrinsic,
    });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : "Internal error";
    return res.status(500).json({ error: message });
  }
});

router.get("/asset/stats", (req: Request, res: Response) => {
  try {
    const stats = AssetRegistry.getStats();

    return res.status(200).json({
      message: "Asset registry statistics",
      uniqueAssets: stats.totalUnique,
      extrinsicStateEntries: stats.totalExtrinsicEntries,
      memorySavings: "High - intrinsic state shared across all requests",
    });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : "Internal error";
    return res.status(500).json({ error: message });
  }
});

router.post("/asset/request", (req: Request, res: Response) => {
  try {
    const { assetId, requester, cacheLevel } = req.body;

    if (!assetId || !requester) {
      return res.status(400).json({ error: "assetId and requester are required." });
    }

    // Get existing flyweight or create
    const asset = AssetRegistry.getOrCreate(
      assetId,
      `/assets/${assetId}.png`,
      "200x200",
      "PNG",
      50000
    );

    // Request with specified cache level
    const extrinsic = asset.request(requester, cacheLevel || "memory");

    return res.status(200).json({
      message: "Asset request logged with extrinsic state",
      assetId,
      requestedBy: extrinsic.requestedBy,
      cacheLevel: extrinsic.cacheLevel,
      priority: extrinsic.priority,
      timestamp: extrinsic.requestTimestamp.toISOString(),
    });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : "Internal error";
    return res.status(500).json({ error: message });
  }
});

export default router;